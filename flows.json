[{
    "id": "mock-publisher",
    "type": "inject",
    "z": "flow1",
    "name": "Publish mock machine metrics",
    "props": [{"p":"payload"},{"p":"topic","vt":"str"}],
    "repeat": "5",
    "crontab": "",
    "once": true,
    "onceDelay": 0.1,
    "topic": "lab/machine/metrics",
    "payload": "{\"machineId\": \"machine-1\", \"temperature\": {{temp}}, \"vibration\": {{vib}}}",
    "payloadType": "json",
    "x": 220,
    "y": 120,
    "wires": [["mqttOut"]]
  },
  {
    "id": "function1",
    "type": "function",
    "z": "flow1",
    "name": "generateMetrics",
    "func": "// generate random values\nmsg.payload = { machineId: '8411bb5e-d1ca-451d-b074-e567dbc93e35', temperature: Math.round(20 + Math.random()*15), vibration: Math.round(Math.random()*100)/10 };\nmsg.topic = 'lab/machine/metrics';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 240,
    "y": 200,
    "wires": [["mqttOut"]]
  },
  {
    "id": "mqttOut",
    "type": "mqtt out",
    "z": "flow1",
    "name": "MQTT Publish",
    "topic": "lab/machine/metrics",
    "qos": "0",
    "retain": "false",
    "broker": "mqttBroker",
    "x": 460,
    "y": 160,
    "wires": []
  },
  {
    "id": "mqttBroker",
    "type": "mqtt-broker",
    "z": "flow1",
    "name": "Local Mosquitto",
    "broker": "mosquitto",
    "port": "1883",
    "clientid": "nodered",
    "usetls": false,
    "compatmode": true,
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "userProps": "",
    "x": 250,
    "y": 320,
    "wires": []
  }
]
